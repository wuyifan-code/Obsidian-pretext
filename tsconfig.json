{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": ".",
		"rootDir": ".",
		"declaration": false,
		"sourceMap": false,
		"lib": ["ES2020", "DOM"]
	},
	"include": ["src/**/*.ts", "main.ts"],
	"exclude": ["node_modules"]
}
